# Resend — https://resend.com
# Without RESEND_API_KEY the endpoint validates, logs, and reports success
# without sending, so the front end can be exercised end to end locally.
RESEND_API_KEY=

# Where enquiries arrive.
CONCIERGE_INBOX=duncan.so@phinklife.org

# Must be a domain verified in Resend, or sends will fail.
CONCIERGE_FROM=Burnout Concierge <concierge@burnoutconcierge.co>
